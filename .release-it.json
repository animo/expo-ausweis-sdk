{
  "github": {
    "release": true
  },
  "hooks": {
    "before:npm:release": "pnpm pack"
  },
  "npm": {
    "skipChecks": true,
    "ignoreVersion": true,
    "tag": "latest"
  },
  "git": {
    "push": false,
    "commit": false,
    "requireCommits": true,
    "tagAnnotation": "${version}",
    "requireBranch": "main"
  }
}
